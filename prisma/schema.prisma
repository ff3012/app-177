generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum OrganizationType {
  FEUERWEHR
  ABSCHNITTSKOMMANDO
}

// Nur für type == FEUERWEHR relevant (bei ABSCHNITTSKOMMANDO-Zeilen ungenutzt, aber die Spalte
// bleibt trotzdem NOT NULL mit Default statt nullable - siehe Kommentar auf
// Organization.feuerwehrKategorie). Vorstufe zu einem künftigen Feature, bei dem eine Person
// Mitglied sowohl einer Freiwilligen Feuerwehr als auch einer Betriebsfeuerwehr sein kann - noch
// nicht Teil dieser Änderung.
enum FeuerwehrKategorie {
  FREIWILLIGE_FEUERWEHR
  BETRIEBSFEUERWEHR
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum DroneRole {
  PILOT
  VIEWER
  ADMIN
}

enum FlightPurpose {
  UEBUNG
  EINSATZ
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  LOGIN
}

enum EventCategory {
  ALLGEMEIN
  DROHNENGRUPPE
}

enum ZusageStatus {
  ZUGESAGT
  ABGESAGT
  UNKLAR
}

enum NewsAudience {
  FIRE_DEPARTMENT
  DRONE_GROUP
}

// Freigabe-Status einer Fahrzeug-Reservierung (Fahrzeug-Reservierung-Freigabe) - OFFEN ist der
// Startzustand einer neuen Reservierung, wenn die Feuerwehr eine Freigabe-E-Mail hinterlegt hat;
// ohne hinterlegte Adresse wird eine Reservierung sofort mit GENEHMIGT angelegt (Rückwärtskompatibilität,
// siehe meine-feuerwehr/actions.ts).
enum VehicleBookingStatus {
  OFFEN
  GENEHMIGT
  ABGELEHNT
}

enum PhotoUploadKind {
  EINSATZ
  UEBUNG
  SONSTIGES
}

// PENDING: Photo-Zeile angelegt, aber noch kein Objekt im Bucket (siehe presign-Route).
// UPLOADING: atomarer Claim während des complete-Schritts (siehe complete-Route) - verhindert einen
// doppelten complete-Aufruf für dieselbe Datei.
// READY: complete-Route hat das Original erfolgreich dekodiert, Vorschauen abgeleitet.
// FAILED: complete ist fehlgeschlagen (kein echtes Bild, zu groß, ...) - Objekt wurde bereits gelöscht.
enum PhotoStatus {
  PENDING
  UPLOADING
  READY
  FAILED
}

// Kategorien der NÖ-Feuerwehr-Dienstgradordnung (NÖ Landesfeuerwehrverband) - rein informativ zur
// Gruppierung im Dropdown, keine Berechtigungslogik hängt daran.
enum DienstgradKategorie {
  MANNSCHAFT
  CHARGE
  OFFIZIER
  VERWALTUNG
  SACHBEARBEITER
  SONDERDIENSTGRAD
  EHRENDIENSTGRAD
}

// ---------- Core org & users ----------

model Organization {
  id                 String             @id @default(cuid())
  name               String             @unique
  shortName          String?
  nummer             String             @unique
  type               OrganizationType
  // Freiwillige Feuerwehr vs. Betriebsfeuerwehr - nur für type == FEUERWEHR bedeutungsvoll, bleibt
  // bei ABSCHNITTSKOMMANDO-Zeilen einfach auf dem Default stehen und wird dort nirgends gelesen.
  // NOT NULL mit Default statt nullable, weil "jede Feuerwehr muss eine von beiden Kategorien haben"
  // eine feste Anforderung ist, nicht optional wie z. B. stbNr. Migration
  // 20260826000000_feuerwehr_kategorie setzt den Default direkt beim ADD COLUMN, sodass jede
  // bestehende Zeile ohne separaten Backfill-Schritt auf FREIWILLIGE_FEUERWEHR landet.
  feuerwehrKategorie FeuerwehrKategorie @default(FREIWILLIGE_FEUERWEHR)
  icsToken           String             @unique @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  // Bezirksverwaltung: deaktivierte Feuerwehren/Abschnitte bleiben vollständig erhalten (Termine,
  // Mitgliedschaften, Historie) - isActive=false blendet sie nur aus NEUEN Zuordnungs-Auswahllisten
  // aus (siehe OrgSearchSelect/event-form.tsx), nie aus bestehenden Verwaltungsansichten. Additiv,
  // default(true) ist für jede bestehende Zeile korrekt - kein Backfill nötig.
  isActive           Boolean            @default(true)

  // Kontaktadresse für die tägliche Atemschutz-Fristen-Warnung (nur FEUERWEHR-Orgs relevant) -
  // bewusst ein eigenes Feld hier statt eines globalen AppSettings-Eintrags, da jede Heimatfeuerwehr
  // ihre eigene Kontaktperson hinterlegen können soll (siehe lib/heimatfeuerwehr/notify-atemschutz-warnung.ts).
  atemschutzSachbearbeiterEmail String?

  // Facebook-Seite für den Feed-Block auf dem Dashboard Feuerwehrhaus (Issue #8) - pro Feuerwehr statt
  // global, aus demselben Grund wie atemschutzSachbearbeiterEmail: jede Heimatfeuerwehr kann ihre eigene
  // Seite hinterlegen. Leer = "Facebook nicht verbunden" auf dem Dashboard.
  facebookPageId          String?
  facebookPageAccessToken String?
  // Sichtbarkeit für den Admin, ob der stündliche Fetch tatsächlich funktioniert - vorher gab es
  // hierfür keine Rückmeldung, ein Fehler (abgelaufener Token, falsche Berechtigung) blieb
  // unsichtbar, selbst wenn der Cron-Job selbst erfolgreich lief (siehe echter Produktionsfall:
  // "Facebook am Dashboard aktualisiert sich nicht"). Gleiches Muster wie
  // icsImportLastSyncAt/-Error und googleCalendarLastSyncAt/-Error.
  facebookLastFetchAt     DateTime?
  facebookLastFetchError  String?

  // Periodischer Read-Only-Import externer Kalendertermine (z. B. ein Google Kalender) in den
  // Kalender dieser Feuerwehr - siehe lib/calendar/ics-import.ts und api/cron/kalender-ics-sync.
  // Öffentliche .ics-Feeds enthalten keine Geheimnisse, daher (anders als
  // facebookPageAccessToken) keine Maskierung im Admin-Formular nötig.
  icsImportUrl           String?
  icsImportLastSyncAt    DateTime?
  icsImportLastSyncError String?

  // Gegenrichtung zu icsImportUrl: schreibt app-177-eigene Termine (icsUid: null, siehe Event) sofort
  // in einen Google Kalender zurück (lib/calendar/google-calendar-push.ts), statt per periodischem
  // Cron - siehe docs/superpowers/specs/2026-08-04-google-calendar-push-sync-design.md. Das
  // Service-Account-JSON ist ein echtes Geheimnis (anders als icsImportUrl) und wird nie ans
  // Client-UI zurückgegeben, analog zu facebookPageAccessToken.
  googleCalendarServiceAccountJson String?
  googleCalendarId                 String?
  googleCalendarLastSyncAt         DateTime?
  googleCalendarLastSyncError      String?

  // Wappen der Feuerwehr für die mobile Tab-Bar/Startbildschirm (Startbildschirm-Brief.md) - Bytes
  // in Postgres statt Dateisystem, analog zu DroneDocument/FacebookPostImage (wenige, kleine
  // Bilder, kein zusätzliches Docker-Volume nötig). Fehlt es, zeigt die Tab-Bar ein neutrales
  // Ersatzsymbol statt eines fremden Wappens.
  wappenImageData     Bytes?
  wappenImageMimeType String?

  // Kontaktadressen für die Freigabe-Anfrage-E-Mail neuer Fahrzeug-Reservierungen (siehe
  // lib/heimatfeuerwehr/notify-vehicle-booking.ts), pro Feuerwehr statt global. Leeres Array =
  // Reservierungen werden ohne Freigabe sofort genehmigt. War ursprünglich ein einzelnes String?-Feld
  // (fahrzeugReservierungEmail) - auf ausdrücklichen Wunsch auf ein Array umgebaut, exakt nach dem
  // Vorbild von photoUploadNotificationEmails direkt darunter (People-Picker + Freitext-Chips, nur
  // Mitglieder der eigenen Heimatfeuerwehr wählbar). Migration
  // 20260821000000_fahrzeug_reservierung_emails_array backfillt bestehende Einzelwerte als
  // Ein-Element-Array, bevor die alte Spalte gelöscht wird.
  fahrzeugReservierungEmails String[] @default([])

  // Empfängeradressen für die Benachrichtigung bei neuen Foto-Upload-Ordnern (GitHub Issue #19) - ein
  // Array statt eines einzelnen String?-Felds (anders als atemschutzSachbearbeiterEmail), da hier
  // ausdrücklich mehrere Adressen gleichzeitig möglich sein sollen; jeder Eintrag ist eine reine,
  // bereits aufgelöste E-Mail-Adresse (egal ob frei eingetippt oder über den People-Picker aus den
  // eigenen Mitgliedern gewählt) - keine Live-Referenz auf einen User, ändert sich also nicht
  // automatisch, falls die Person später ihre E-Mail ändert oder die Feuerwehr verlässt. Leeres
  // Array = keine Benachrichtigung (siehe lib/heimatfeuerwehr/notify-photo-upload.ts).
  photoUploadNotificationEmails String[] @default([])

  // Funktionsschalter je Heimatfeuerwehr (Funktionsschalter-Brief.md) - Abschalten blendet nur aus,
  // löscht nichts; Reaktivierung zeigt alle Daten unverändert wieder. featureAtemschutz defaultet auf
  // true (Bestandswehren verlieren nichts durch die Migration), featureFacebook auf false - ohne Token
  // gäbe es ohnehin nichts anzuzeigen (die Migration setzt es zusätzlich per Backfill auf true für jede
  // Organisation, die bereits ein vollständiges Facebook-Zugangstoken hinterlegt hat).
  featureAtemschutz     Boolean   @default(true)
  featureFacebook       Boolean   @default(false)
  featuresUpdatedAt     DateTime?
  featuresUpdatedByName String?

  members      User[]        @relation("HomeOrganization")
  secondaryHomeMembers User[] @relation("SecondaryHomeOrganization")
  memberships  Membership[]
  events       Event[]
  newsPosts    NewsPost[]
  vehicles     Vehicle[]
  photoUploads PhotoUpload[]
  pendingRegistrations PendingRegistration[]

  dashboardTokens   DashboardToken[]
  facebookPostCache FacebookPostCache?

  // Nur für type == ABSCHNITTSKOMMANDO gesetzt: der Bezirk, dem dieser Abschnitt angehört.
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  // Nur für type == FEUERWEHR gesetzt: die Organization-Zeile (type == ABSCHNITTSKOMMANDO) ihres
  // Abschnitts. Selbstreferenzierend statt einer eigenen Section-Tabelle - Abschnitt ist bereits
  // heute eine Organization-Zeile, keine zweite Tabelle für dasselbe Konzept.
  parentId String?
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrgHierarchy")

  droneGroups DroneGroup[]

  @@index([districtId])
  @@index([parentId])
  @@index([type])
}

// Bezirk (z. B. "17 St. Pölten") - oberste Ebene der Hierarchie Bezirk -> Abschnitt -> Feuerwehr.
// Eigenes Modell statt einer Konstante, um künftig einen zweiten Bezirk ohne Schemaänderung
// aufnehmen zu können (siehe docs/superpowers/specs/2026-08-09-bezirk-abschnitt-drohnengruppen-design.md).
model District {
  id     String @id @default(cuid())
  number String @unique // "17"
  name   String // "St. Pölten"

  organizations Organization[]
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  stbNr              String?
  phone              String?
  isActive           Boolean  @default(true)
  homeOrganizationId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Additiv, beide nullable - für Bestandsbenutzer ist unbekannt, wann sie sich zuletzt
  // angemeldet oder ihr Passwort geändert haben (siehe Benutzerverwaltung-Brief.md §2). Bewusst
  // NICHT rückwirkend mit createdAt befüllt - ein erfundener Wert ist schlechter als "unbekannt".
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Atemschutz (Modul "Meine Feuerwehr") - gepflegt ausschließlich über Verwaltung/Heimatfeuerwehr,
  // Mitglieder haben dort nur Einsicht. atemschutzGueltigBis ist bewusst ein eigenes, explizit
  // gesetztes Feld statt "atemschutzUntersuchungAm + 5 Jahre" errechnet, da die Gültigkeit laut
  // Arzt auch kürzer sein kann. atemschutzFinnentestAm hat keine eigene Gültig-bis-Spalte, da der
  // Finnentest laut Vorgabe eine fixe, nicht verhandelbare Jahresfrist hat (siehe
  // lib/heimatfeuerwehr/atemschutz-status.ts).
  istAtemschutzgeraeteTraeger Boolean   @default(false)
  atemschutzUntersuchungAm    DateTime?
  atemschutzGueltigBis        DateTime?
  atemschutzFinnentestAm      DateTime?

  // Rohtext der medizinischen Tauglichkeitsbewertung aus dem Atemschutz-Untersuchungs-Import (siehe
  // docs/superpowers/specs/2026-09-04-atemschutz-import-design.md) - bewusst kein Enum, um keine
  // Information aus dem Original-Export zu verlieren. Bewusst NICHT "Status" genannt: dieser Begriff ist
  // in atemschutz-status.ts/ATEMSCHUTZ_EXCEL_COLUMNS bereits für den Gültigkeits-/Ablauf-Zustand
  // (Aktiv/Läuft bald ab/Abgelaufen) belegt - ein anderes, unabhängiges Konzept vom medizinischen
  // Tauglich/Untauglich-Ergebnis hier.
  atemschutzTauglichkeitsart           String?
  atemschutzFinnentestTauglichkeitsart String?

  // Dienstgrad laut zentraler NÖ-Dienstgradtabelle (siehe Dienstgrad-Modell unten) - nullable, da
  // Bestandsbenutzer noch keinen zugewiesen haben.
  dienstgradId String?
  dienstgrad   Dienstgrad? @relation(fields: [dienstgradId], references: [id])

  // Zweite Heimatfeuerwehr (GitHub Issue #21, siehe
  // docs/superpowers/specs/2026-08-25-zweite-heimatfeuerwehr-design.md) - optional, eine FF + eine
  // BTF (nie zwei vom selben Typ, app-seitig geprüft in admin/benutzer/actions.ts, kein
  // DB-Constraint). Das Mitglied kann im Profil-Dropdown zwischen homeOrganizationId/dienstgradId und
  // diesem Paar wechseln (switchHomeOrganization) - ein atomarer Tausch beider Paare, kein
  // gleichzeitiges "beides sichtbar".
  secondaryOrganizationId String?
  secondaryOrganization   Organization? @relation("SecondaryHomeOrganization", fields: [secondaryOrganizationId], references: [id])
  secondaryDienstgradId   String?
  secondaryDienstgrad     Dienstgrad?   @relation("SecondaryDienstgrad", fields: [secondaryDienstgradId], references: [id])

  createdPhotoUploads PhotoUpload[]
  uploadedPhotos      Photo[]

  // Bezirksweites, von jeder Organisation unabhängiges Admin-Recht (siehe permissions.ts) - ersetzt
  // die bisherige globale Wirkung von isSiteAdmin, die mit mehreren Abschnitten nicht mehr korrekt
  // wäre. Default false: niemand ist automatisch Bezirksadmin, siehe Task 3 für den Bootstrap-Admin.
  isBezirksAdmin Boolean @default(false)

  // Bezirksweites Recht, alle 4 Drohnengruppen zu sehen/verwalten, unabhängig von einer eigenen
  // Drohnengruppen-Mitgliedschaft - eigenständig von isBezirksAdmin, jemand kann keines, eines oder
  // beide haben. Siehe docs/superpowers/specs/2026-08-10-bezirksadmin-drohnenadmin-rollen-design.md.
  isBezirksDrohnenAdmin Boolean @default(false)

  // Persönliche, gespeicherte Kalender-Filtereinstellung (siehe docs/superpowers/specs/
  // 2026-09-01-kalender-sondergruppen-design.md) - welche Sondergruppen dieses Mitglied im eigenen
  // Kalender ausblendet. Leeres Array ist ein bewusster Opt-in-Sentinel ("noch keine Auswahl
  // getroffen" = alle Sondergruppen ausgeblendet), keine Bedeutung als "nichts ausgeblendet" - siehe
  // die Standardlogik in kalender/page.tsx.
  ausgeblendeteSondergruppenIds String[] @default([])

  homeOrganization       Organization             @relation("HomeOrganization", fields: [homeOrganizationId], references: [id])
  memberships            Membership[]
  droneMembership        DrohnengruppeMembership?
  createdEvents          Event[]                  @relation("EventCreatedBy")
  registeredFlights      DroneFlight[]            @relation("FlightRegisteredBy")
  pilotedFlights         DroneFlight[]            @relation("FlightPilot")
  passwordTokens         PasswordToken[]
  pushSubscriptions      PushSubscription[]
  fcmTokens              FcmToken[]
  newsPostsCreated       NewsPost[]               @relation("NewsPostCreatedBy")
  newsReads              NewsRead[]
  terminZusagen          TerminZusage[]
  droneDocumentsUploaded DroneDocument[]          @relation("DroneDocumentUploadedBy")
  vehicleBookings        VehicleBooking[]         @relation("VehicleBookingDriver")
  vehicleBookingsAsAdmin VehicleBooking[]         @relation("VehicleBookingBookedByAdmin")
  dashboardTokensCreated DashboardToken[]

  @@index([homeOrganizationId])
}

// Zentrale Tabelle aller Dienstgrade der Feuerwehren in Niederösterreich (NÖ
// Landesfeuerwehrverband-Dienstgradordnung) - eine einzige Quelle statt eines freien Textfelds, damit
// "Dienstgrad" in der Benutzerverwaltung als Dropdown mit den amtlichen Kurzformen (LM, HBI, ABI, FM,
// SB, EOBI, ...) gepflegt wird, nicht als Freitext, der sich mit der Zeit auseinanderentwickeln würde.
// sortOrder trägt die fachliche Hierarchie innerhalb jeder Kategorie (niedrigster Dienstgrad zuerst),
// nicht nur alphabetische Ordnung - kurzform ist @unique und die einzig sichtbare Form in Tabelle/Sheet
// (siehe Benutzerverwaltung); bezeichnung ist nur eine Verständnishilfe im Dropdown selbst.
model Dienstgrad {
  id          String              @id @default(cuid())
  kurzform    String              @unique
  bezeichnung String
  kategorie   DienstgradKategorie
  sortOrder   Int                 @unique

  users User[]
  secondaryDienstgradUsers User[] @relation("SecondaryDienstgrad")
  pendingRegistrations PendingRegistration[]

  @@index([kategorie])
}

// Erweiterbare, über die Bezirksverwaltung gepflegte Liste von Sonderinteressen-Gruppen
// (Feuerwehrjugend/Schadstoffgruppe/Kommanden/...) für die Kalender-Kategorisierung - siehe
// docs/superpowers/specs/2026-09-01-kalender-sondergruppen-design.md. Rein informativ: keine eigene
// Mitgliedschaft/kein eigenes Sichtbarkeits-Gate wie bei DroneGroup, nur ein optionales Tag an
// ALLGEMEIN-Terminen plus eine persönliche Anzeige-Filtereinstellung pro Mitglied (siehe
// User.ausgeblendeteSondergruppenIds). sortOrder ist @unique wie bei Dienstgrad, für eine feste
// Anzeige-Reihenfolge statt alphabetisch.
model Sondergruppe {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @unique
  isActive  Boolean @default(true)

  events Event[]
}

// Login-Rate-Limiting: getrackt pro eingegebener E-Mail-Adresse (auch wenn sie zu keinem
// Benutzer gehört), damit ein Lockout selbst nicht verrät, ob ein Account existiert.
model LoginAttempt {
  id            String    @id @default(cuid())
  email         String    @unique
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

// Rate-Limiting für angeforderte E-Mail-Anmelde-Token/Codes - dieselbe Idee wie LoginAttempt
// (pro eingegebener E-Mail-Adresse, unabhängig davon ob ein Konto existiert), aber ein eigenes
// Modell statt einer Wiederverwendung von LoginAttempt, da es ein anderes Ereignis zählt (eine
// tatsächlich ausgestellte Token-Anfrage, nicht ein fehlgeschlagener Login-Versuch).
model LoginTokenRequestAttempt {
  id             String    @id @default(cuid())
  email          String    @unique
  requestCount   Int       @default(0)
  firstRequestAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model PendingRegistration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  stbNr          String
  dienstgradId   String?
  dienstgrad     Dienstgrad?  @relation(fields: [dienstgradId], references: [id], onDelete: SetNull)
  email          String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RegistrationAttempt {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  attemptCount   Int       @default(1)
  firstAttemptAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

// One-time links for account activation and "Passwort vergessen". The token
// column stores a SHA-256 hash of the random token, never the raw value.
// shortCode (also hashed) is only ever set for TokenPurpose.LOGIN: a 6-digit alternative to the
// long token, meant to be pasted directly into an already-open page (e.g. an iOS home-screen PWA,
// which can't receive a session from a link opened in Safari - see login/actions.ts). Consuming
// either the long token or the short code invalidates both, since they're the same login grant.
model PasswordToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  shortCode String?
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin/staff rights, scoped per organization
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId])
}

// Flat cross-org group membership for the drone team
model DrohnengruppeMembership {
  id      String    @id @default(cuid())
  userId  String    @unique
  role    DroneRole @default(PILOT)
  addedAt DateTime  @default(now())

  a1a3LizenzAm            DateTime?
  a2LizenzAm              DateTime?
  stuetzpunktausbildungAm DateTime?
  bos1AusbildungAm        DateTime?
  bos2AusbildungAm        DateTime?

  droneGroupId String
  droneGroup   DroneGroup @relation(fields: [droneGroupId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([droneGroupId])
}

// Eine von mehreren eigenständigen Drohnengruppen (bisher: eine einzige, flache Gruppe). Jede
// Gruppe ist an einem Abschnitt (Organization.type == ABSCHNITTSKOMMANDO) verankert.
model DroneGroup {
  id             String       @id @default(cuid())
  name           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Bezirksverwaltung - dieselbe Semantik wie Organization.isActive oben.
  isActive       Boolean      @default(true)

  // Ersetzt das bisherige AppSettings.droneQuickRegisterToken (Singleton-Feld) - jetzt pro Gruppe
  // statt app-weit.
  qrToken String? @unique

  // Ersetzte ursprünglich AppSettings.droneFlightNotificationEmail (Singleton) als einzelnes
  // String?-Feld pro Gruppe; auf ausdrücklichen Wunsch auf ein Array umgebaut, exakt nach dem Vorbild
  // von Organization.photoUploadNotificationEmails/fahrzeugReservierungEmails (People-Picker +
  // Freitext-Chips, hier nur Mitglieder DIESER Drohnengruppe statt einer Heimatfeuerwehr wählbar).
  // Migration 20260822000000_drone_group_flight_notification_emails_array backfillt bestehende
  // Einzelwerte als Ein-Element-Array, bevor die alte Spalte gelöscht wird. Leeres Array = keine
  // Benachrichtigung bei neuen Drohnenflügen dieser Gruppe.
  flightNotificationEmails String[] @default([])

  memberships DrohnengruppeMembership[]
  documents   DroneDocument[]
  drones      Drone[]
  events      Event[]
  newsPosts   NewsPost[]

  @@index([organizationId])
}

// ---------- Module 1: Terminplanung ----------

model Event {
  id             String        @id @default(cuid())
  title          String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean       @default(false)
  organizationId String
  isSectionWide  Boolean       @default(false)
  category       EventCategory @default(ALLGEMEIN)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Gesetzt, wenn dieser Termin automatisch aus einer Fahrzeug-Buchung erzeugt wurde (siehe
  // meine-feuerwehr/actions.ts) - sein bloßes Vorhandensein markiert den Termin als
  // "buchungsverwaltet" und schützt ihn vor normaler Bearbeitung/Löschung im Kalender
  // (kalender/[eventId]/bearbeiten/page.tsx, kalender/actions.ts).
  vehicleBookingId String?         @unique
  vehicleBooking   VehicleBooking? @relation(fields: [vehicleBookingId], references: [id], onDelete: SetNull)

  // Gesetzt (auf die UID des Quell-VEVENT) für per ICS-Sync importierte Termine (siehe
  // lib/calendar/ics-import.ts) - schützt den Termin genau wie vehicleBookingId vor normaler
  // Bearbeitung/Löschung im Kalender, da der nächste Sync (alle 5 Minuten) jede manuelle Änderung
  // ohnehin überschreiben bzw. den Termin als "nicht mehr in der Quelle" wieder löschen würde.
  // Zusammen mit organizationId eindeutig, da dieselbe externe UID theoretisch in mehreren
  // Feuerwehren importiert werden könnte (jede mit ihrem eigenen icsImportUrl).
  icsUid String?

  // Gegenrichtung: die Google-Calendar-Event-Id, sobald dieser (app-177-eigene, icsUid: null)
  // Termin einmal nach Google gepusht wurde (siehe lib/calendar/google-calendar-push.ts) - erlaubt
  // spätere Updates/Löschungen als PATCH/DELETE statt eines erneuten POST.
  googleEventId String?

  // Nur für category == DROHNENGRUPPE gesetzt: welche Drohnengruppe dieser Termin betrifft -
  // schränkt die Sichtbarkeit auf deren Mitglieder ein (siehe Task 8).
  droneGroupId String?
  droneGroup   DroneGroup? @relation(fields: [droneGroupId], references: [id])

  // Nur für category == ALLGEMEIN relevant (siehe docs/superpowers/specs/
  // 2026-09-01-kalender-sondergruppen-design.md) - rein informative Zusatzkategorie
  // (Feuerwehrjugend/Schadstoffgruppe/Kommanden/...), fließt NICHT in canViewEvent/canManageEvent
  // ein. onDelete: SetNull, damit eine später deaktivierte/gelöschte Sondergruppe bestehende
  // Termine nicht blockiert.
  sondergruppeId String?
  sondergruppe   Sondergruppe? @relation(fields: [sondergruppeId], references: [id], onDelete: SetNull)

  // Dritte Geltungsbereichs-Stufe für category == ALLGEMEIN, additiv neben dem bestehenden
  // isSectionWide - siehe canViewEvent. Für category == DROHNENGRUPPE bleibt dies immer false
  // (Sichtbarkeit läuft dort ausschließlich über droneGroupId).
  isDistrictWide Boolean @default(false)

  organization Organization   @relation(fields: [organizationId], references: [id])
  createdBy    User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  zusagen      TerminZusage[]
  newsPosts    NewsPost[]

  @@unique([organizationId, icsUid])
  @@index([organizationId, startsAt])
  @@index([isSectionWide, startsAt])
}

// RSVP pro Termin und Benutzer. Eine Zeile pro (eventId, userId) - erneutes Setzen aktualisiert
// die bestehende Zeile (upsert), erzeugt keine Historie.
model TerminZusage {
  id        String       @id @default(cuid())
  eventId   String
  userId    String
  status    ZusageStatus
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ---------- Module 2: Drohnengruppe ----------

model Drone {
  id        String  @id @default(cuid())
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  droneGroupId String
  droneGroup   DroneGroup @relation(fields: [droneGroupId], references: [id])

  flights DroneFlight[]

  // Task 9 Review-Fix: war zuvor global @unique - zwei verschiedene Drohnengruppen konnten dadurch
  // nicht beide eine Drohne "Drohne 1" nennen (fast garantiert zu kollidieren, da das der naheliegende
  // Name für die jeweils erste Drohne einer neuen Gruppe ist). Eindeutigkeit ist jetzt PRO Gruppe.
  @@unique([droneGroupId, name])
  @@index([droneGroupId])
}

/**
 * Singleton-Tabelle für Einstellungen aus der Verwaltung (immer genau eine Zeile, id="singleton").
 */
model AppSettings {
  id                           String    @id @default("singleton")
  systemCheckNotificationEmail String?
  lastNewsCronRunAt            DateTime?
  lastBackupAt                 DateTime?
  lastS3BackupAt               DateTime?
  updatedAt                    DateTime  @updatedAt
}

model DroneFlight {
  id             String        @id @default(cuid())
  startsAt       DateTime
  pilotUserId    String
  location       String
  droneId        String
  purpose        FlightPurpose
  notes          String?
  registeredById String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  drone        Drone @relation(fields: [droneId], references: [id])
  pilotUser    User  @relation("FlightPilot", fields: [pilotUserId], references: [id])
  registeredBy User  @relation("FlightRegisteredBy", fields: [registeredById], references: [id])

  @@index([startsAt])
  @@index([droneId])
  @@index([pilotUserId])
}

// Unterlagen (PDFs) für Mitglieder der Drohnengruppe. Der PDF-Inhalt liegt direkt in der DB
// (bytea), nicht auf einem eigenen Volume - erspart einen zusätzlichen Docker-Mount und läuft
// automatisch im bestehenden pg_dump-Backup mit. Bei den erwarteten wenigen, kleinen Dateien für
// diese Gruppe (~handful Dokumente) überwiegt das gegenüber Dateisystem-Speicherung.
model DroneDocument {
  id           String   @id @default(cuid())
  title        String
  filename     String
  sizeBytes    Int
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  droneGroupId String
  droneGroup   DroneGroup @relation(fields: [droneGroupId], references: [id])

  uploadedBy User @relation("DroneDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([droneGroupId])
  @@index([createdAt])
}

// ---------- Module 3: News (Web-Push-Benachrichtigungen) ----------

// Eine Web-Push-Registrierung pro Gerät/Browser-Installation eines Benutzers (nicht pro Benutzer:
// dieselbe Person kann mehrere Geräte/PWA-Installationen abonniert haben). endpoint ist von der
// Push-Service-URL des Browsers vorgegeben und damit von Natur aus eindeutig.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ein registriertes Android-Gerät für natives Push über Firebase Cloud Messaging (FCM) - siehe
// docs/superpowers/specs/2026-08-27-android-native-push-fcm-design.md. Bewusst eine eigene Tabelle,
// keine Erweiterung von PushSubscription: ein FCM-Token ist ein einzelner String, keine
// endpoint/p256dh/auth-Kombination wie bei Web Push, und beide Mechanismen laufen dauerhaft parallel
// (ein User kann beides gleichzeitig haben - Browser-Session + Android-App).
model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NewsPost {
  id               String       @id @default(cuid())
  audience         NewsAudience
  fireDepartmentId String?
  droneGroupId     String?
  title            String
  body             String
  eventId          String?
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdById      String
  createdAt        DateTime     @default(now())

  fireDepartment Organization? @relation(fields: [fireDepartmentId], references: [id])
  droneGroup     DroneGroup?   @relation(fields: [droneGroupId], references: [id])
  event          Event?        @relation(fields: [eventId], references: [id])
  createdBy      User          @relation("NewsPostCreatedBy", fields: [createdById], references: [id])
  reads          NewsRead[]

  @@index([scheduledAt])
  @@index([fireDepartmentId])
  @@index([droneGroupId])
}

model NewsRead {
  newsPostId String
  userId     String
  readAt     DateTime @default(now())

  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([newsPostId, userId])
}

// ---------- Module 4: Meine Feuerwehr (Fuhrpark) ----------

// Ein Fahrzeug im Fuhrpark einer Heimatfeuerwehr, ausborgbar von deren Mitgliedern.
// kennzeichen ist @unique, weil ein österreichisches Kennzeichen real eindeutig ist.
model Vehicle {
  id                   String   @id @default(cuid())
  organizationId       String
  taktischeBezeichnung String
  kennzeichen          String   @unique
  marke                String
  typ                  String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  bookings     VehicleBooking[]

  @@index([organizationId])
}

// Eine Ausborg-Buchung für ein Fahrzeug. Überlappende Buchungen für dasselbe vehicleId werden
// serverseitig verhindert (siehe lib/heimatfeuerwehr/vehicle-availability.ts), nicht per
// DB-Constraint - Postgres-Exclusion-Constraints sind über Prisma nicht abbildbar.
model VehicleBooking {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  // Pflichtfeld im Buchungsformular (jeder Ausborger füllt es aus), aber NUR für
  // Heimatfeuerwehr-Admins sichtbar - weder auf /meine-feuerwehr ("Meine Buchungen") noch im
  // öffentlichen Dashboard-Kiosk noch im erzeugten Kalender-Termin (Titel/Beschreibung bleiben
  // unverändert). Nullable in der DB, da bereits bestehende Buchungen keinen Wert haben können -
  // die Pflicht wird ausschließlich im Formular/Zod-Schema erzwungen, nicht per DB-Constraint.
  details String?

  // Freigabe-Workflow: neue Reservierungen starten OFFEN, wenn die Feuerwehr mindestens eine
  // fahrzeugReservierungEmails-Adresse hinterlegt hat (sonst sofort GENEHMIGT, siehe Enum-Kommentar). Der
  // verknüpfte Kalender-Termin (event) wird erst bei GENEHMIGT angelegt - solange eine Reservierung
  // OFFEN ist, existiert dafür noch kein Event, sie ist also für niemanden außer dem Ausborger
  // selbst sichtbar. approvalToken ist ein roher (nicht gehashter) Capability-Token für die beiden
  // Genehmigen/Ablehnen-Links in der Freigabe-Mail - analog zu DashboardToken.token, nicht wie
  // PasswordToken gehasht, da es kein Auth-Credential ist, sondern ein einmaliger Aktions-Link mit
  // geringem Schadenspotenzial. Bleibt nach der Entscheidung stehen (nicht genullt) - die
  // Genehmigen/Ablehnen-Seite prüft stattdessen status !== OFFEN, um einen bereits verwendeten Link
  // freundlich als "schon entschieden" statt als kaputt anzuzeigen.
  status        VehicleBookingStatus @default(GENEHMIGT)
  approvalToken String?              @unique

  // Optionaler Freitext, den der Fahrzeug-Admin beim Ablehnen (in einem eigenen Zwischenschritt vor
  // der eigentlichen Entscheidung, siehe booking-decision-view.tsx) hinterlassen kann - erklärt dem
  // Ausborger, warum das Fahrzeug in diesem Zeitraum nicht reserviert werden kann. Nur bei ABGELEHNT
  // gesetzt; bei GENEHMIGT immer null.
  rejectionReason String?

  // Gesetzt, wenn ein Feuerwehr-Admin diese Reservierung stellvertretend für ein anderes
  // Mitglied angelegt hat (userId ist dann der Fahrer, nicht der Admin) - null bei einer
  // normalen Selbst-Buchung. Analog zu DroneFlight.registeredBy/pilotUser. onDelete: SetNull,
  // damit ein späteres Löschen des Admin-Kontos die Buchung selbst nicht mitreißt.
  bookedByAdmin   User?   @relation("VehicleBookingBookedByAdmin", fields: [bookedByAdminId], references: [id], onDelete: SetNull)
  bookedByAdminId String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation("VehicleBookingDriver", fields: [userId], references: [id], onDelete: Cascade)
  event   Event?

  @@index([vehicleId, startsAt])
}

// ---------- Module 5: Fotos hochladen ----------

// Ein "Anlass" zum Sammeln von Fotos (Foto-Upload-Brief.md, vereinfachte Fassung) - bewusst KEINE
// Einsatzdokumentation: kein Ort, keine Einsatzzeiten, keine Mannschaftserfassung. Genau drei
// Nutzerfelder: kind, description, occurredOn. Gehört immer genau EINER Feuerwehr. Jedes Mitglied
// der Feuerwehr darf anlegen/bearbeiten/löschen (siehe canManagePhotoUploadsFor) - keine
// Rollen-Einschränkung, da dieses Projekt keine Rollentabelle kennt (nur Dienstgrad, eine reine
// Anzeige-Tabelle ohne Berechtigungslogik).
model PhotoUpload {
  id               String          @id @default(cuid())
  fireDepartmentId String
  fireDepartment   Organization    @relation(fields: [fireDepartmentId], references: [id])
  kind             PhotoUploadKind
  description      String
  occurredOn       DateTime
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  photos Photo[]

  @@index([fireDepartmentId])
  @@index([createdAt])
}

// Ein hochgeladenes Foto. storageKey/previewKey/thumbKey sind S3-Objektschlüssel im Bucket
// app-177-pictures (siehe lib/storage/photo-uploads-s3.ts) - NICHT die Bilddaten selbst. Das
// Original bleibt byteidentisch im Bucket; previewKey/thumbKey sind abgeleitete WebP-Objekte, beide
// null solange status != READY. KEIN publicRelease-Feld - die Fotorechte gehen laut
// Feststellungstext beim Anlegen automatisch mit dem Hochladen an die Feuerwehr über, kein Schalter,
// keine Filterung danach nötig.
model Photo {
  id            String      @id @default(cuid())
  photoUploadId String
  photoUpload   PhotoUpload @relation(fields: [photoUploadId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  storageKey    String
  previewKey    String?
  thumbKey      String?
  originalName  String
  mimeType      String
  byteSize      Int
  width         Int?
  height        Int?
  takenAt       DateTime?
  status        PhotoStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  @@index([photoUploadId])
  @@index([status, createdAt])
}

// Token für den öffentlichen, session-losen Kiosk-Dashboard-Screen im Feuerwehrhaus (Issue #8) - analog
// zum QR-Code-Schnellerfassungs-Token der Drohnengruppe (AppSettings.droneQuickRegisterToken), aber als
// eigene Tabelle statt eines Singleton-Felds, da mehrere Tokens pro Feuerwehr mit individuellem
// Ablauf/Widerruf möglich sein müssen.
model DashboardToken {
  id             String    @id @default(cuid())
  token          String    @unique
  organizationId String
  createdById    String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// Stündlich vom Cron-Job (api/cron/facebook-fetch) befüllter Cache der letzten Facebook-Beiträge einer
// Feuerwehr-Seite - ein Eintrag pro Organisation, damit ein Neustart oder ein Graph-API-Ausfall den
// Dashboard-Feed nicht leert (siehe Design-Spec §6).
model FacebookPostCache {
  id             String   @id @default(cuid())
  organizationId String   @unique
  posts          Json
  fetchedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Heruntergeladene Beitragsbilder, Bytes in Postgres statt Dateisystem - analog zu DroneDocument (PDFs):
// kein zusätzliches Docker-Volume, läuft automatisch im bestehenden pg_dump-Backup mit. Eigene Tabelle
// statt eines Felds auf FacebookPostCache, damit beim stündlichen Refresh nur tatsächlich neue Bilder
// geschrieben werden (Abgleich über postId), nicht das gesamte Cache-JSON samt alter Bilder neu.
model FacebookPostImage {
  id        String   @id @default(cuid())
  postId    String   @unique
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

// Letztes erfolgreich abgerufenes WASTL-Übersichtsbild, gleiches Bytes-in-Postgres-Muster wie
// FacebookPostImage - ein einzelner Datensatz reicht, da die Karte nicht org-spezifisch ist (ganz NÖ).
model WastlImageCache {
  id        String   @id @default("singleton")
  data      Bytes
  mimeType  String
  fetchedAt DateTime @default(now())
}
