generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum OrganizationType {
  FEUERWEHR
  ABSCHNITTSKOMMANDO
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum DroneRole {
  PILOT
  VIEWER
  ADMIN
}

enum FlightPurpose {
  UEBUNG
  EINSATZ
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  LOGIN
}

enum EventCategory {
  ALLGEMEIN
  DROHNENGRUPPE
}

enum ZusageStatus {
  ZUGESAGT
  ABGESAGT
  UNKLAR
}

enum NewsAudienceType {
  ORGANIZATION
  DROHNENGRUPPE
}

// ---------- Core org & users ----------

model Organization {
  id        String           @id @default(cuid())
  name      String           @unique
  shortName String?
  nummer    String           @unique
  type      OrganizationType
  icsToken  String           @unique @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Kontaktadresse für die tägliche Atemschutz-Fristen-Warnung (nur FEUERWEHR-Orgs relevant) -
  // bewusst ein eigenes Feld hier statt eines globalen AppSettings-Eintrags, da jede Heimatfeuerwehr
  // ihre eigene Kontaktperson hinterlegen können soll (siehe lib/heimatfeuerwehr/notify-atemschutz-warnung.ts).
  atemschutzSachbearbeiterEmail String?

  members      User[]        @relation("HomeOrganization")
  memberships  Membership[]
  events       Event[]
  newsMessages NewsMessage[]
  vehicles     Vehicle[]

  @@index([type])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  stbNr              String?
  phone              String?
  isActive           Boolean  @default(true)
  homeOrganizationId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Atemschutz (Modul "Meine Feuerwehr") - gepflegt ausschließlich über Verwaltung/Heimatfeuerwehr,
  // Mitglieder haben dort nur Einsicht. atemschutzGueltigBis ist bewusst ein eigenes, explizit
  // gesetztes Feld statt "atemschutzUntersuchungAm + 5 Jahre" errechnet, da die Gültigkeit laut
  // Arzt auch kürzer sein kann. atemschutzFinnentestAm hat keine eigene Gültig-bis-Spalte, da der
  // Finnentest laut Vorgabe eine fixe, nicht verhandelbare Jahresfrist hat (siehe
  // lib/heimatfeuerwehr/atemschutz-status.ts).
  istAtemschutzgeraeteTraeger Boolean   @default(false)
  atemschutzUntersuchungAm    DateTime?
  atemschutzGueltigBis        DateTime?
  atemschutzFinnentestAm      DateTime?

  homeOrganization       Organization             @relation("HomeOrganization", fields: [homeOrganizationId], references: [id])
  memberships            Membership[]
  droneMembership        DrohnengruppeMembership?
  createdEvents          Event[]                  @relation("EventCreatedBy")
  registeredFlights      DroneFlight[]            @relation("FlightRegisteredBy")
  pilotedFlights         DroneFlight[]            @relation("FlightPilot")
  passwordTokens         PasswordToken[]
  pushSubscriptions      PushSubscription[]
  newsMessagesCreated    NewsMessage[]            @relation("NewsCreatedBy")
  terminZusagen          TerminZusage[]
  droneDocumentsUploaded DroneDocument[]          @relation("DroneDocumentUploadedBy")
  vehicleBookings        VehicleBooking[]

  @@index([homeOrganizationId])
}

// Login-Rate-Limiting: getrackt pro eingegebener E-Mail-Adresse (auch wenn sie zu keinem
// Benutzer gehört), damit ein Lockout selbst nicht verrät, ob ein Account existiert.
model LoginAttempt {
  id            String    @id @default(cuid())
  email         String    @unique
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

// Rate-Limiting für angeforderte E-Mail-Anmelde-Token/Codes - dieselbe Idee wie LoginAttempt
// (pro eingegebener E-Mail-Adresse, unabhängig davon ob ein Konto existiert), aber ein eigenes
// Modell statt einer Wiederverwendung von LoginAttempt, da es ein anderes Ereignis zählt (eine
// tatsächlich ausgestellte Token-Anfrage, nicht ein fehlgeschlagener Login-Versuch).
model LoginTokenRequestAttempt {
  id             String    @id @default(cuid())
  email          String    @unique
  requestCount   Int       @default(0)
  firstRequestAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

// One-time links for account activation and "Passwort vergessen". The token
// column stores a SHA-256 hash of the random token, never the raw value.
// shortCode (also hashed) is only ever set for TokenPurpose.LOGIN: a 6-digit alternative to the
// long token, meant to be pasted directly into an already-open page (e.g. an iOS home-screen PWA,
// which can't receive a session from a link opened in Safari - see login/actions.ts). Consuming
// either the long token or the short code invalidates both, since they're the same login grant.
model PasswordToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  shortCode String?
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin/staff rights, scoped per organization
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId])
}

// Flat cross-org group membership for the drone team
model DrohnengruppeMembership {
  id      String    @id @default(cuid())
  userId  String    @unique
  role    DroneRole @default(PILOT)
  addedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Module 1: Terminplanung ----------

model Event {
  id             String        @id @default(cuid())
  title          String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean       @default(false)
  organizationId String
  isSectionWide  Boolean       @default(false)
  category       EventCategory @default(ALLGEMEIN)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Gesetzt, wenn dieser Termin automatisch aus einer Fahrzeug-Buchung erzeugt wurde (siehe
  // meine-feuerwehr/actions.ts) - sein bloßes Vorhandensein markiert den Termin als
  // "buchungsverwaltet" und schützt ihn vor normaler Bearbeitung/Löschung im Kalender
  // (kalender/[eventId]/bearbeiten/page.tsx, kalender/actions.ts).
  vehicleBookingId String?         @unique
  vehicleBooking   VehicleBooking? @relation(fields: [vehicleBookingId], references: [id], onDelete: SetNull)

  organization Organization   @relation(fields: [organizationId], references: [id])
  createdBy    User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  zusagen      TerminZusage[]

  @@index([organizationId, startsAt])
  @@index([isSectionWide, startsAt])
}

// RSVP pro Termin und Benutzer. Eine Zeile pro (eventId, userId) - erneutes Setzen aktualisiert
// die bestehende Zeile (upsert), erzeugt keine Historie.
model TerminZusage {
  id        String       @id @default(cuid())
  eventId   String
  userId    String
  status    ZusageStatus
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ---------- Module 2: Drohnengruppe ----------

model Drone {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  flights DroneFlight[]
}

/**
 * Singleton-Tabelle für Einstellungen aus der Verwaltung (immer genau eine Zeile, id="singleton").
 */
model AppSettings {
  id                           String    @id @default("singleton")
  droneFlightNotificationEmail String?
  droneQuickRegisterToken      String?
  systemCheckNotificationEmail String?
  lastNewsCronRunAt            DateTime?
  lastBackupAt                 DateTime?
  lastS3BackupAt               DateTime?
  updatedAt                    DateTime  @updatedAt
}

model DroneFlight {
  id             String        @id @default(cuid())
  startsAt       DateTime
  pilotUserId    String
  location       String
  droneId        String
  purpose        FlightPurpose
  notes          String?
  registeredById String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  drone        Drone @relation(fields: [droneId], references: [id])
  pilotUser    User  @relation("FlightPilot", fields: [pilotUserId], references: [id])
  registeredBy User  @relation("FlightRegisteredBy", fields: [registeredById], references: [id])

  @@index([startsAt])
  @@index([droneId])
  @@index([pilotUserId])
}

// Unterlagen (PDFs) für Mitglieder der Drohnengruppe. Der PDF-Inhalt liegt direkt in der DB
// (bytea), nicht auf einem eigenen Volume - erspart einen zusätzlichen Docker-Mount und läuft
// automatisch im bestehenden pg_dump-Backup mit. Bei den erwarteten wenigen, kleinen Dateien für
// diese Gruppe (~handful Dokumente) überwiegt das gegenüber Dateisystem-Speicherung.
model DroneDocument {
  id           String   @id @default(cuid())
  title        String
  filename     String
  sizeBytes    Int
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation("DroneDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([createdAt])
}

// ---------- Module 3: News (Web-Push-Benachrichtigungen) ----------

// Eine Web-Push-Registrierung pro Gerät/Browser-Installation eines Benutzers (nicht pro Benutzer:
// dieselbe Person kann mehrere Geräte/PWA-Installationen abonniert haben). endpoint ist von der
// Push-Service-URL des Browsers vorgegeben und damit von Natur aus eindeutig.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Eine Push-Nachricht an eine Zielgruppe (eine Feuerwehr oder die Drohnengruppe), sofort oder
// terminiert. scheduledAt=null + sentAt gesetzt bedeutet "sofort gesendet"; scheduledAt gesetzt +
// sentAt=null bedeutet "wartet auf den Versand-Cronjob".
model NewsMessage {
  id            String           @id @default(cuid())
  title         String
  body          String
  audienceType  NewsAudienceType
  audienceOrgId String?
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdById   String
  createdAt     DateTime         @default(now())

  audienceOrg Organization? @relation(fields: [audienceOrgId], references: [id])
  createdBy   User          @relation("NewsCreatedBy", fields: [createdById], references: [id])

  @@index([scheduledAt])
}

// ---------- Module 4: Meine Feuerwehr (Fuhrpark) ----------

// Ein Fahrzeug im Fuhrpark einer Heimatfeuerwehr, ausborgbar von deren Mitgliedern.
// kennzeichen ist @unique, weil ein österreichisches Kennzeichen real eindeutig ist.
model Vehicle {
  id                   String   @id @default(cuid())
  organizationId       String
  taktischeBezeichnung String
  kennzeichen          String   @unique
  marke                String
  typ                  String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  bookings     VehicleBooking[]

  @@index([organizationId])
}

// Eine Ausborg-Buchung für ein Fahrzeug. Überlappende Buchungen für dasselbe vehicleId werden
// serverseitig verhindert (siehe lib/heimatfeuerwehr/vehicle-availability.ts), nicht per
// DB-Constraint - Postgres-Exclusion-Constraints sind über Prisma nicht abbildbar.
model VehicleBooking {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event?

  @@index([vehicleId, startsAt])
}
