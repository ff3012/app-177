# Postgres (used by docker-compose to create the DB and by DATABASE_URL below)
POSTGRES_USER=ffapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ffapp

# Prisma connection string
# Local dev (docker-compose.dev.yml exposes Postgres on localhost:5432):
DATABASE_URL="postgresql://ffapp:change-me@localhost:5432/ffapp?schema=public"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-random-32-byte-base64-string
AUTH_URL=http://localhost:3000

# Bootstrap admin account created by prisma/seed.ts
SEED_ADMIN_EMAIL=admin@abschnitt-purkersdorf.at
SEED_ADMIN_PASSWORD=change-me-after-first-login

# Shared secret for the combined (all 9 Feuerwehren) .ics calendar feed URL.
# Generate with: openssl rand -hex 16
ABSCHNITTS_ICS_TOKEN=change-me-to-a-random-string

# Mailjet (E-Mail-Versand: Konto-Aktivierung, Passwort vergessen)
# API-Key/Secret: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=change-me
MAILJET_API_SECRET=change-me
MAILJET_FROM_EMAIL=noreply@ff-wolfsgraben.at
MAILJET_FROM_NAME=AFKDO Purkersdorf

# Web-Push (News-Modul). Generieren nach dem ersten Build im Container:
#   docker compose -f docker/docker-compose.yml --env-file .env exec app node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# mailto:-Adresse oder https-URL, mit der Push-Dienste den Absender bei Problemen kontaktieren können.
VAPID_SUBJECT=mailto:florian.krebs@feuerwehr.gv.at

# Geteiltes Secret für den Cronjob, der terminierte News versendet (docker/send-scheduled-news.sh).
# Generieren mit: openssl rand -hex 16
CRON_SECRET=change-me-to-a-random-string

# Off-Box-Kopie der nächtlichen Backups auf S3-kompatiblen Object Storage (z. B. Exoscale SOS),
# siehe docker/backup.sh. Optional - wenn S3_BACKUP_BUCKET leer/nicht gesetzt ist, macht das Skript
# nur das lokale pg_dump-Backup wie bisher.
S3_BACKUP_BUCKET=
S3_ENDPOINT_URL=https://sos-at-vie-1.exo.io
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
