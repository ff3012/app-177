# Vorlage für die Test-/Dev-Umgebung (dev.app-177.ff-wolfsgraben.at), siehe docker/README.md,
# "Zweiter Stack für eine Test-/Dev-Umgebung". Nach /opt/app-177-dev/.env kopieren und ausfüllen.
#
# WICHTIG: JEDER Wert hier muss sich von der Produktions-.env unterscheiden (eigene Postgres-Zugangsdaten,
# eigenes AUTH_SECRET, eigene Tokens) - dieselben Werte wie Prod zu verwenden würde Sessions/Tokens
# zwischen den beiden Umgebungen ungültig machen können und im schlimmsten Fall die falsche Datenbank
# ansprechen.

# Postgres - eigene, von Prod komplett getrennte Zugangsdaten und Datenbank.
POSTGRES_USER=ffapp_dev
POSTGRES_PASSWORD=change-me-neu-generieren
POSTGRES_DB=ffapp_dev

# Prisma-Verbindungsstring - "postgres" ist hier der Servicename in docker-compose.staging.yml,
# nicht der Prod-Container (der eigene Compose-Stack hat seinen eigenen "postgres"-Service).
DATABASE_URL="postgresql://ffapp_dev:change-me-neu-generieren@postgres:5432/ffapp_dev?schema=public"

# Auth.js - NIEMALS denselben Wert wie in Prod verwenden.
# Generieren mit: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=change-me-neu-generieren
AUTH_URL=https://dev.app-177.ff-wolfsgraben.at

# Bootstrap-Admin für diese Test-Umgebung - eigene, klar als Test erkennbare Adresse verwenden.
SEED_ADMIN_EMAIL=admin@dev.app-177.ff-wolfsgraben.at
SEED_ADMIN_PASSWORD=change-me-nach-erstem-login

# Eigener Token für diesen Stack - niemals den Prod-Token wiederverwenden.
# Generieren mit: openssl rand -hex 16
ABSCHNITTS_ICS_TOKEN=change-me-neu-generieren

# Mailjet - SICHERHEITSHINWEIS: dieselbe Mailjet-API wie Prod zu verwenden ist nur unproblematisch,
# solange in dieser Umgebung ausschließlich mit prisma/seed.ts erzeugte Test-Benutzer existieren
# (also KEIN Import/Kopie echter Produktionsdaten mit echten Mitglieder-E-Mail-Adressen!) - sonst
# könnte ein Testlauf (Aktivierungs-Mail, Passwort-Reset, News) echte E-Mails an echte Feuerwehrleute
# auslösen. MAILJET_FROM_NAME unten macht jede von hier gesendete Mail zusätzlich als Test erkennbar.
MAILJET_API_KEY=change-me
MAILJET_API_SECRET=change-me
MAILJET_FROM_EMAIL=noreply@ff-wolfsgraben.at
MAILJET_FROM_NAME=AFKDO Purkersdorf (TEST)

# Web-Push - eigenes Schlüsselpaar, nicht das Prod-Schlüsselpaar wiederverwenden (siehe
# docker/README.md, "Zweiter Stack" - Push-Abos sind ohnehin browserspezifisch und würden zwischen
# den beiden Umgebungen nicht funktionieren, ein eigenes Paar vermeidet trotzdem jede Verwechslung).
# Generieren nach dem ersten Build:
#   docker compose -p app177-dev -f docker/docker-compose.staging.yml --env-file .env exec dev-app node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:florian.krebs@feuerwehr.gv.at

# Eigenes Secret für diesen Stack - nur relevant, falls du terminierte News/Cron-Features hier testest.
# Generieren mit: openssl rand -hex 16
CRON_SECRET=change-me-neu-generieren

# Absichtlich leer gelassen - siehe docker-compose.staging.yml, kein Off-Box-Backup für Testdaten.
S3_BACKUP_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
